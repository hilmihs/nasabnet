,"src":["Mu'jam al-Buldan 2/249","Mu'jam al-Buldan 5/354","Ibnu Sa'd 3/604"],"lat":24.4709,"lon":39.623},{"t":"Harrat al-Wabarah","ar":"حرة الوبرة","kind":"harrah","note":"Harrah 3 mil dari Madinah, disebut dalam hadits Uhban tentang tanda kenabian. Label di kawasan Harrat al-Wabarah","src":["Mu'jam al-Buldan 2/250"],"lat":24.459,"lon":39.5823},{"t":"Bairuha' (kebun Abu Thalhah)","ar":"بيرحاء","kind":"kebun","note":"Kebun kurma Abu Thalhah di depan Masjid Nabawi; Nabi ﷺ masuk, berteduh dan minum airnya; disedekahkan Abu Thalhah","src":["Shahih al-Bukhari 2/119","Shahih al-Bukhari 4/8","Mu'jam al-Buldan 1/299"],"lat":24.4703,"lon":39.6108},{"t":"al-'Awali (al-'Aliyah)","ar":"العوالي","kind":"kebun","note":"Tanah pertanian 3–4 mil dari Madinah (terjauh 8 mil); di al-'Aliyah Bani an-Nadhir membuat kebun dan benteng","src":["Mu'jam al-Buldan 4/166","Mu'jam al-Buldan 1/446"],"lat":24.4558,"lon":39.6271},{"t":"Bani an-Najjar","ar":"بنو النجار","kind":"kawasan","note":"Al-Mathari: Masjid Nabawi dan sebelah timurnya dar Bani Ghanm bin Malik bin an-Najjar; rumah-rumah Bani an-Najjar membentang ke utara sampai Masjid al-Ijabah","src":["Wafa' al-Wafa' 1/169"],"lat":24.4683,"lon":39.6108},{"t":"Bani Sa'idah","ar":"بنو ساعدة","kind":"kawasan","note":"Dar Bani Sa'idah di timur Suq al-Madinah; menurut al-Mathari kampung mereka di Bi'r Budha'ah, sumur itu di tengah rumah-rumah mereka","src":["Wafa' al-Wafa' 1/165"],"lat":24.4724,"lon":39.608},{"t":"Bani Salimah","ar":"بنو سلمة","kind":"kawasan","note":"Bani Salimah tinggal antara Masjid al-Qiblatain sampai al-Madzad (benteng Bani Haram) di kaki harrah barat; Masjid al-Qiblatain milik Bani Sawad bin Ghanm dari Bani Salimah","src":["Wafa' al-Wafa' 1/159","Wafa' al-Wafa' 1/160"],"lat":24.4842,"lon":39.5789},{"t":"Bani Zuraiq","ar":"بنو زريق","kind":"kawasan","note":"Bani Zuraiq pindah dari dar Bani Bayadhah ke dar mereka di selatan al-Mushalla, di tempat yang dikenal sebagai Dzarwan","src":["Wafa' al-Wafa' 1/163"],"lat":24.4657,"lon":39.6128},{"t":"Bani 'Abdil Asyhal","ar":"بنو عبد الأشهل","kind":"kawasan","note":"Masjid Bani 'Abdil Asyhal (Masjid Waqim) di perkampungan mereka, tempat Nabi ﷺ salat Maghrib; as-Samhudi: letak masjidnya tak dikenal lagi di masanya (titik = identifikasi modern)","src":["Wafa' al-Wafa' 3/61","Wafa' al-Wafa' 3/62"],"lat":24.4709,"lon":39.623},{"t":"Bani Haritsah","ar":"بنو حارثة","kind":"kawasan","note":"Di dar kedua mereka Bani Haritsah membangun benteng ar-Rayyan dekat Masjid Bani Haritsah; rumah-rumah Bani Haritsah di sekitar asy-Syaikhain","src":["Wafa' al-Wafa' 1/153"],"lat":24.4919,"lon":39.6097},{"t":"Bani 'Amr bin 'Auf","ar":"بنو عمرو بن عوف","kind":"kawasan","note":"Bani 'Amr bin 'Auf (Aus) bermukim di Quba' dan membangun benteng-benteng di sana","src":["Wafa' al-Wafa' 1/154"],"lat":24.4418,"lon":39.6176},{"t":"Bani Mu'awiyah (Aus)","ar":"بنو معاوية","kind":"kawasan","note":"Bani Mu'awiyah bin Malik (Aus) tinggal di dar mereka di balik Baqi' al-Gharqad; Masjid al-Ijabah adalah masjid Bani Mu'awiyah","src":["Wafa' al-Wafa' 1/155"],"lat":24.4719,"lon":39.6183},{"t":"Bani Waqif","ar":"بنو واقف","kind":"kawasan","note":"Bani Waqif dan as-Silm (Aus) bermukim dekat Masjid al-Fadhikh; as-Samhudi: tak ada dar yang lebih jelas letaknya daripada dar mereka","src":["Wafa' al-Wafa' 1/155","Wafa' al-Wafa' 3/71"],"lat":24.446,"lon":39.6377},{"t":"Bani Salim bin 'Auf","ar":"بنو سالم بن عوف","kind":"kawasan","note":"Nabi ﷺ mendapati Jumat di Bani Salim bin 'Auf dan salat di masjid di perut Wadi Ranuna' (Masjid al-Jumu'ah)","src":["Mu'jam al-Buldan 3/19"],"lat":24.4455,"lon":39.6152},{"t":"Bani Unaif","ar":"بنو أنيف","kind":"kawasan","note":"Bani Unaif, kabilah dari Baliyy sekutu Aus, di Quba'; Nabi ﷺ salat dekat benteng mereka, kemudian tempat itu dibangun menjadi Masjid Bani Unaif","src":["Wafa' al-Wafa' 3/71"],"lat":24.4357,"lon":39.6155},{"t":"Bani an-Nadhir","ar":"بنو النضير","kind":"kawasan","note":"Yahudi Bani an-Nadhir: al-Waqidi berkata permukiman mereka di arah al-Ghars (Bi'r Ghars); as-Samhudi: di an-Nawa'im, membentang ke arah al-Ghars","src":["Wafa' al-Wafa' 1/131"],"lat":24.4451,"lon":39.6273},{"t":"Bani Quraizhah","ar":"بنو قريظة","kind":"kawasan","note":"Yahudi Bani Quraizhah bermukim di Wadi Mahzur di al-'Aliyah (Bani an-Nadhir di Buthan)","src":["Mu'jam al-Buldan 1/446","Wafa' al-Wafa' 1/130"],"lat":24.4387,"lon":39.651},{"t":"Uthum ar-Rayyan (Bani Haritsah)","ar":"أطم الريان","kind":"benteng","note":"Benteng ar-Rayyan milik Bani Majda'ah bin Haritsah, di dekat Masjid Bani Haritsah","src":["Wafa' al-Wafa' 1/153"],"lat":24.4919,"lon":39.6097},{"t":"Uthum Syas","ar":"أطم شاس","kind":"benteng","note":"Benteng Syas milik Syas bin Qais dari Bani 'Athiyyah bin Zaid, di sebelah kiri pelataran Masjid Quba' menghadap kiblat","src":["Wafa' al-Wafa' 1/156"],"lat":24.4394,"lon":39.6175},{"t":"Uthum al-Mustazhill","ar":"أطم المستظل","kind":"benteng","note":"Benteng al-Mustazhill milik Uhaihah bin al-Julah (Bani 'Amr bin 'Auf), letaknya di Bi'r Ghars","src":["Wafa' al-Wafa' 1/154"],"lat":24.4451,"lon":39.6273},{"t":"Uthum al-Muzdalif","ar":"المزدلف","kind":"benteng","note":"Benteng al-Muzdalif milik 'Itban bin Malik / Malik bin al-'Ajlan di dar Bani Salim; Masjid 'Itban di kakinya, di utara Masjid al-Jumu'ah","src":["Wafa' al-Wafa' 3/73"],"lat":24.4463,"lon":39.6155},{"t":"Suq al-Madinah","ar":"سوق المدينة","kind":"pasar","note":"Nabi ﷺ meninjau pasar Bani Qainuqa', lalu menetapkan Suq al-Madinah: 'inilah pasar kalian, tanpa pungutan'; lebarnya dari al-Mushalla (batas selatan) sampai Jirar Sa'd; Masjid al-Mushalla di samping pasar (titik: Masjid al-Mushalla/al-Ghamamah)","src":["Tarikh al-Madinah Ibnu Syabbah 1/304","Wafa' al-Wafa' 2/257","Wafa' al-Wafa' 2/262"],"lat":24.4658,"lon":39.6069},{"t":"Khandaq (parit)","ar":"الخندق","kind":"parit","note":"Parit Perang Ahzab di utara kota: digaris dari asy-Syaikhain di tepi Bani Haritsah; Muhajirin menggali dari Ratij ke Dzubab (bukit Masjid ar-Rayah), Anshar dari Dzubab ke Bani 'Ubaid; al-Mathari: sampai Masjid al-Fath; kaum Muslimin membelakangi Sal'. Garis perkiraan","src":["Wafa' al-Wafa' 4/70","Ibnu Sa'd 2/66","Wafa' al-Wafa' 3/49"],"lines":[[[24.4919,39.6097],[24.4804,39.6035],[24.4778,39.5957]]]}],"makkah":[{"t":"Bathn 'Uranah (Wadi 'Uranah)","ar":"عرنة","kind":"wadi","note":"Wadi di hadapan 'Arafat; Bathn 'Uranah ialah dasar wadi tempat Masjid 'Arafah, dan seluruh alirannya. Garis: ruas di sisi 'Arafat","src":["Mu'jam al-Buldan 4/111","Mu'jam ma Ista'jam 4/1191"],"lines":[[[21.39438,39.98992],[21.39427,39.98961],[21.38866,39.98612],[21.38557,39.98365],[21.38473,39.98377],[21.38335,39.98311],[21.38197,39.98122],[21.36087,39.97206],[21.35938,39.97051],[21.35715,39.9673]],[[21.35715,39.9673],[21.35689,39.9669]],[[21.35689,39.9669],[21.34489,39.94962],[21.34093,39.94511],[21.33919,39.94278],[21.32952,39.92627],[21.328,39.9243],[21.32502,39.92202],[21.32079,39.91929]]]},{"t":"Bathn Marr (Marr azh-Zhahran)","ar":"مر الظهران","kind":"wadi","note":"Semarhalah dari Makkah; azh-Zhahran nama wadinya, Marr desanya, banyak mata air dan kurma; di Bathn Marr dua wadi Nakhlah bertemu. Garis: Wadi Fathimah di OSM (nama lama Bathn Marr / Marr azh-Zhahran)","src":["Mu'jam al-Buldan 5/104","Mu'jam al-Buldan 1/449"],"lines":[[[21.72281,39.82825],[21.72295,39.82701],[21.72207,39.82291],[21.71888,39.81681],[21.71521,39.80879],[21.71577,39.80128],[21.718,39.79295],[21.72203,39.78729],[21.72482,39.78282],[21.72506,39.77411],[21.72402,39.76802],[21.72203,39.76055],[21.71716,39.75596],[21.70632,39.75308],[21.70022,39.75304],[21.68539,39.74617],[21.66556,39.73171],[21.65599,39.73017],[21.6378,39.72467],[21.62647,39.71695],[21.62043,39.71332],[21.6145,39.71043],[21.61046,39.70983],[21.6011,39.70407],[21.58528,39.69781],[21.58026,39.69513],[21.57441,39.68901],[21.56933,39.68322],[21.56361,39.68051],[21.55842,39.67511],[21.55311,39.67177],[21.54833,39.6672],[21.54453,39.66396],[21.5404,39.66407],[21.53763,39.66381],[21.53452,39.66063],[21.53212,39.65784],[21.53007,39.65448